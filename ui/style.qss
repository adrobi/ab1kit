/* ab1kit light theme. Explicit colours so the chrome never follows the OS mode. */
QWidget { background-color: #f6f7f9; color: #1a1a1a; font-size: 13px; }
QMainWindow, QDialog { background-color: #f6f7f9; }
QToolTip { background-color: #ffffff; color: #1a1a1a; border: 1px solid #d0d5dd; padding: 4px 6px; }

QMenuBar { background-color: #eceef2; border-bottom: 1px solid #d0d5dd; }
QMenuBar::item { padding: 5px 10px; background: transparent; }
QMenuBar::item:selected { background-color: #e1e5eb; border-radius: 4px; }
QMenu { background-color: #ffffff; border: 1px solid #d0d5dd; padding: 4px; }
QMenu::item { padding: 5px 24px 5px 24px; border-radius: 4px; }
QMenu::item:selected { background-color: #2f6fed; color: #ffffff; }
QMenu::item:disabled { color: #8a8f98; }
QMenu::separator { height: 1px; background: #d0d5dd; margin: 4px 6px; }

QToolBar { background-color: #eceef2; border: none; border-bottom: 1px solid #d0d5dd; padding: 3px; spacing: 2px; }
QToolBar > QWidget { background: transparent; }
QToolBar::separator { background-color: #d0d5dd; width: 1px; margin: 4px 6px; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 5px; padding: 4px 6px; }
QToolButton:hover { background-color: #e1e5eb; border-color: #d0d5dd; }
QToolButton:pressed { background-color: #cfd5de; }
QToolButton:disabled { color: #8a8f98; }

QPushButton { background-color: #ffffff; border: 1px solid #d0d5dd; border-radius: 5px; padding: 5px 14px; }
QPushButton:hover { background-color: #e1e5eb; }
QPushButton:pressed { background-color: #cfd5de; }
QPushButton:default { border-color: #2f6fed; }
QPushButton:disabled { color: #8a8f98; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: #ffffff; border: 1px solid #d0d5dd; border-radius: 4px; padding: 3px 6px;
    selection-background-color: #2f6fed; selection-color: #ffffff; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #2f6fed; }

QDockWidget { titlebar-close-icon: none; }
QDockWidget::title { background-color: #eceef2; border-bottom: 1px solid #d0d5dd; padding: 5px 8px; font-weight: 600; }

QTableView, QTableWidget { background-color: #ffffff; alternate-background-color: #f6f7f9;
    gridline-color: #d0d5dd; border: 1px solid #d0d5dd; selection-background-color: #2f6fed; selection-color: #ffffff; }
QHeaderView::section { background-color: #eceef2; color: #1a1a1a; padding: 4px 8px; border: none;
    border-right: 1px solid #d0d5dd; border-bottom: 1px solid #d0d5dd; font-weight: 600; }

QScrollBar:vertical { background: transparent; width: 12px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #c3c8d1; border-radius: 5px; min-height: 24px; min-width: 24px; margin: 2px; }
QScrollBar::handle:hover { background: #8a8f98; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QProgressBar { background-color: #ffffff; border: 1px solid #d0d5dd; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background-color: #2f6fed; border-radius: 3px; }
QStatusBar { background-color: #eceef2; border-top: 1px solid #d0d5dd; }
QStatusBar::item { border: none; }
QCheckBox { spacing: 6px; background: transparent; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #8a8f98; border-radius: 3px; background-color: #ffffff; }
QCheckBox::indicator:checked { background-color: #2f6fed; border-color: #2f6fed; }
QCheckBox::indicator:disabled { border-color: #d0d5dd; }
QLabel { background: transparent; }
